MAIL_1=you@yourdomain.com
MAIL_1_PASSWORD=
MAIL_2=                      # optional second mailbox; leave empty if you don't need it
MAIL_2_PASSWORD=
# MAIL_1_LABEL=work                  # internal label agents use to pick the mailbox (never shown to recipients)
# MAIL_1_NAME='Your Name'            # sender name recipients see in the From line
ADMIN_PASSWORD=change-me-12-or-more-characters
BETTER_AUTH_SECRET=          # openssl rand -base64 32

# Local only (on Vercel these are set for you)
DATABASE_URL=postgres://localhost/imap_mcp
APP_URL=http://localhost:3000

# Self-host with Docker (docker-compose.yml): also set these two.
# DOMAIN=mail-mcp.example.com          # a domain pointing at your server
# POSTGRES_PASSWORD=                   # openssl rand -hex 16
# Wrap values containing $ in single quotes, e.g. MAIL_1_PASSWORD='pa$word'
